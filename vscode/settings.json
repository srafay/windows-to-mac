{
    "github.copilot.nextEditSuggestions.enabled": true,
    "roo-cline.allowedCommands": [
        "git log",
        "git diff",
        "git show"
    ],
    "roo-cline.deniedCommands": [],
    // Python type checking mode
    "python.analysis.typeCheckingMode": "standard",
    "security.workspace.trust.untrustedFiles": "open",
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.defaultColorDecorators": "never",
        "editor.formatOnType": true,
        "editor.wordBasedSuggestions": "off",
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "aws.telemetry": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    // Add common layer to pylance
    "python.analysis.extraPaths": [
        "./lambda/SharedLib/python",
        "./lambda/Layers/PackagingLayer/python"
    ],
    // Use python env extension
    // "python.useEnvironmentsExtension": true,
    // Load from .env file
    "python.terminal.useEnvFile": true,
    // Cfn linter path from pyenv
    "cfnLint.path": "/Users/syed/.pyenv/shims/cfn-lint",
    // YAML tags to recognize in CloudFormation templates from https://github.com/redhat-developer/vscode-yaml/issues/669
    "yaml.customTags": [
        "!Base64 scalar",
        "!Cidr scalar",
        "!And sequence",
        "!Equals sequence",
        "!If sequence",
        "!Not sequence",
        "!Or sequence",
        "!Condition scalar",
        "!FindInMap sequence",
        "!GetAtt scalar",
        "!GetAtt sequence",
        "!GetAZs scalar",
        "!ImportValue scalar",
        "!Join sequence",
        "!Select sequence",
        "!Split sequence",
        "!Sub scalar",
        "!Transform mapping",
        "!Ref scalar",
        "!And",
        "!If",
        "!Not",
        "!Equals",
        "!Or",
        "!FindInMap",
        "!Base64",
        "!Join",
        "!Cidr",
        "!Ref",
        "!Sub",
        "!Sub sequence",
        "!GetAtt",
        "!GetAZs",
        "!ImportValue",
        "!ImportValue sequence",
        "!Select",
        "!Split"
    ],
    "redhat.telemetry.enabled": false,
    "kilo-code.allowedCommands": [
        "git log",
        "git diff",
        "git show"
    ],
    "kilo-code.deniedCommands": [],
    "aws.resources.enabledResources": [
        "AWS::DynamoDB::Table"
    ],
    "aws.cloudformation.telemetry.enabled": false,
    "claudeCode.preferredLocation": "panel",
    "roo-cline.debug": false,
    "claudeCode.selectedModel": "default",
    "explorer.confirmDelete": false,
    "chat.viewSessions.orientation": "stacked",
    "workbench.colorTheme": "Dark Modern",
    "workbench.iconTheme": "bearded-icons",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.gpuAcceleration": "off"
}